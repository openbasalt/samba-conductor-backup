# conductor-backup on a domain controller
# (/etc/conductor-backup/conductor-backup.toml, root:conductor-backup 0640).
# No secret goes in this file: keys and passwords are systemd credentials
# (LoadCredential= in conductor-backup.service), referenced by name.

realm = "EXAMPLE.COM"
# This DC's short name in object names (default: the host name).
# dc = "dc1"
# state_dir = "/var/lib/conductor-backup"
# helper_socket = "/run/conductor-helper/backup.sock"

# Credential holding this DC's manifest signing key
# (`conductor-backup keygen signing --out /etc/conductor-backup/credentials/signing-key`).
signing_key = "signing-key"
# Public keys of the drill hosts (`conductor-backup pubkey <their key>`):
# only reports signed by them are shown.
drill_public_keys = []
# The age recipients: the operators' offline keys plus the drill host's.
# Root-owned; conductor-helper refuses it if anyone else may write it.
recipients_file = "/etc/conductor-backup/recipients.txt"
# Download every upload again and check its SHA-256 (default true).
verify_after_upload = true

[[destination]]
name = "s3"
type = "s3"
endpoint = "https://s3.example.com"
region = "us-east-1"
bucket = "example-ad-backups"
prefix = ""
path_style = true
# ca_file = "/etc/conductor-backup/s3-ca.pem"   # pin the endpoint's CA
credentials = "s3"                               # TOML: access_key_id, secret_access_key
# object_lock_mode = "GOVERNANCE"                # bucket created with object lock
# object_lock_days = 30

# [[destination]]
# name = "local"
# type = "local"
# path = "/var/backups/conductor-backup"

[alert]
email_to = ["ops@example.com"]
email_from = "conductor-backup@dc1.example.com"
smtp_server = "mail.example.com:587"
smtp_security = "starttls"        # starttls | tls | none (loopback relay only)
# smtp_ca_file = "/etc/conductor-backup/smtp-ca.pem"
# smtp_credentials = "smtp"       # TOML: username, password
# webhook_url = "https://hooks.example.com/conductor-backup"
# webhook_secret = "webhook"      # signs the body (X-Conductor-Signature)
