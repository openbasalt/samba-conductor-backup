# conductor-backup on a domain controller: backs up when the schedule says
# so (or when asked), uploads, verifies, prunes, exchanges drill
# requests/reports and sends alerts. Runs as its own unprivileged user; the
# privileged part (samba-tool with the backup account, encryption) is done
# by conductor-helper. Started by conductor-backup.timer (hourly) and
# conductor-backup.path (a "back up now" / "run drill now" request).
[Unit]
Description=Samba Conductor encrypted domain backup
Documentation=https://github.com/samba-conductor/conductor-backup
After=network-online.target conductor-helper.service
Wants=network-online.target
Requires=conductor-helper.service

[Service]
Type=oneshot
User=conductor-backup
Group=conductor-backup
ExecStart=/usr/local/bin/conductor-backup run --scheduled --config /etc/conductor-backup/conductor-backup.toml
TimeoutStartSec=2h

# The signing key and the destinations' credentials (S3 keys, SMTP) as
# systemd credentials, readable only by this service. Add one line per
# credential named in conductor-backup.toml (credentials = "…").
LoadCredential=signing-key:/etc/conductor-backup/credentials/signing-key
LoadCredential=s3:/etc/conductor-backup/credentials/s3

StateDirectory=conductor-backup conductor-backup/spool conductor-backup/requests
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# A local destination directory (path = … in the configuration).
ReadWritePaths=-/var/backups/conductor-backup
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/conductor-backup
InaccessiblePaths=-/etc/conductor-backup/credentials
