# Restore drills on a drill host (NEVER on a domain controller: the drill
# identity can decrypt backups). Runs as root: the sandbox needs network,
# mount and PID namespaces and samba-tool restore needs root. Every drill
# restores into a fresh, network-less sandbox that pivots into a minimal
# root, drops capabilities and installs a seccomp filter before anything
# from the backup runs, and shreds its plaintext (docs/design.md, "Restore
# drill sandbox"). The directives below confine the whole service on top of
# that; each one is compatible with what the sandbox does itself.
[Unit]
Description=Samba Conductor restore drill
Documentation=https://github.com/openbasalt/samba-conductor-backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/conductor-backup drill --config /etc/conductor-backup/drill.toml
TimeoutStartSec=1h
LoadCredential=drill-identity:/etc/conductor-backup/credentials/drill-identity
LoadCredential=drill-signing-key:/etc/conductor-backup/credentials/drill-signing-key
LoadCredential=drill-probe-password:/etc/conductor-backup/credentials/drill-probe-password
LoadCredential=s3:/etc/conductor-backup/credentials/s3
StateDirectory=conductor-backup-drill
StateDirectoryMode=0700
UMask=0077

# Capabilities: the sandbox's setup (namespaces, mounts and pivot_root:
# CAP_SYS_ADMIN; the dummy interface: CAP_NET_ADMIN; dropping the bounding
# set: CAP_SETPCAP) plus what it keeps for samba-tool and Samba.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SETPCAP CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_KILL CAP_SETGID CAP_SETUID CAP_NET_BIND_SERVICE
AmbientCapabilities=
NoNewPrivileges=yes

# The file system: read-only except the state directory (the drill's
# work_dir; another work_dir needs ReadWritePaths=), a private /tmp and
# /dev, no home directories, and the credentials only through
# $CREDENTIALS_DIRECTORY.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=-/etc/conductor-backup/credentials
ProtectProc=invisible

# The kernel.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
# Not ProtectHostname=: it would also forbid the sandbox naming its own
# UTS namespace (the restored DC's host name).

# Namespaces: only the ones the sandbox creates (no user or cgroup
# namespaces).
RestrictNamespaces=net mnt pid uts ipc
# S3, alerts and the restored DC (IPv4/IPv6, Unix sockets); netlink for
# the sandbox's interfaces and Samba's interface list.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# System calls: what services use, plus mounting and pivot_root (@mount),
# seccomp (@sandbox) and sethostname for the sandbox's setup. The sandbox
# installs a stricter filter of its own before samba-tool runs.
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount @sandbox sethostname
SystemCallErrorNumber=EPERM
